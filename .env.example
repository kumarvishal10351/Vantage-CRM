# ============================================================================
# Vantage CRM Backend Environment Configuration
# ============================================================================

# Environment Mode: 'development' | 'production'
# In 'production', JWT_SECRET_KEY must be a unique, secure secret.
ENVIRONMENT=development

# Application Metadata
PROJECT_NAME="Sales CRM & Pipeline Management Platform"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Database Connection
# ----------------------------------------------------------------------------
# Option 1 (Cloud / Render): Provide the full PostgreSQL connection URL.
# If DATABASE_URL is set, it takes precedence over DB_* variables.
# DATABASE_URL=postgresql://user:password@hostname:5432/crm_platform

# Option 2 (Local Development / Discrete Parameters):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_platform
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Connection Pooling (Optimized for Render Free/Starter tiers)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Comma-separated allowed frontend origins (local dev origins are included automatically)
# Example for production:
# CORS_ORIGINS=https://vantage-crm.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
